# Core runtime
AWS_DEFAULT_REGION=eu-central-1
PORT=8081
LOG_LEVEL=INFO

# Portkey — the company's governed LLM gateway. Every LangGraph agent's model
# client (llm/portkey.py) goes through this; nothing calls a provider
# directly.
PORTKEY_BASE_URL=https://portkey.syngenta.com/v1
# PORTKEY_MODEL_ID=@az-openai/gpt-4.1-mini

# Shared agent secret (AWS Secrets Manager). One secret holds every key:
# PORTKEY_API_KEY, and optionally DD_API_KEY / AMPLITUDE_API_KEY / CONFIDENT_API_KEY.
# Legacy name PORTKEY_SECRET_NAME is still accepted.
AGENT_SECRET_NAME=coreagents-dev-pmp_agent-secret

# Local dev — set directly instead of AGENT_SECRET_NAME. Leave unset to disable.
# PORTKEY_API_KEY=pk-...

# Local dev / manual smoke-testing only. builder.build_client_deck() makes a
# REAL Portkey/LLM call by default (the Brief Agent, generating the
# Commercial Intelligence Brief's 5 narrative slides — see
# pipeline/narrative_agent_runner.py). Set this to skip it: those 5 slides
# render as a plain "not yet generated" placeholder instead, so you can
# exercise the rest of the deck-generation pipeline for free. The automated
# test suite always sets this itself (tests/conftest.py) regardless of this
# file — never relies on it being set here.
# SKIP_NARRATIVE_AGENT=true

# Databricks — real data via mcp_tools/databricks_gateway.py, which runs each
# approved sql_registry.py template's SQL directly against a real warehouse
# (Statement Execution API), with named-parameter binding for the template's
# `:param` placeholders. A real workspace PAT token, not per-rep identity —
# see that module's docstring for the caveat and why the Unity Catalog
# Functions MCP path (tried first) didn't fit this catalog/schema. Without
# these, data_access.py falls back to the local dbx-data sample. See
# example.env at the repo root.
# PM_DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# PM_DATABRICKS_TOKEN=dapi...
# PM_DATABRICKS_CATALOG=...
# PM_DATABRICKS_SCHEMA=...
# Optional — pins the SQL warehouse; unset auto-picks the first RUNNING one.
# PM_DATABRICKS_WAREHOUSE_ID=...

# Runtime URL in agent card (local dev)
AGENTCORE_RUNTIME_URL=http://127.0.0.1:8081/

# Authorization — comma-separated AD group object-IDs
# Leave commented out for local dev without auth.
# ALLOWED_AD_GROUPS=group-object-id-1,group-object-id-2

# Local dev only: lets a browser-based test UI running on another origin/port
# call this agent's /invocations AG-UI endpoint.
# CORS_ORIGINS=*

# Windows local dev — prevents UnicodeEncodeError when LLM emits emoji
PYTHONIOENCODING=utf-8
