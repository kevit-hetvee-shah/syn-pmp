# Core runtime
AWS_DEFAULT_REGION=eu-central-1
PORT=8081
LOG_LEVEL=INFO

# Shared agent secret (AWS Secrets Manager). One secret holds every key:
# PORTKEY_API_KEY, and optionally DD_API_KEY / AMPLITUDE_API_KEY / CONFIDENT_API_KEY.
# Legacy name PORTKEY_SECRET_NAME is still accepted.
AGENT_SECRET_NAME=coreagents-dev-test_agent-secret
PORTKEY_BASE_URL=https://portkey.syngenta.com/v1
# PORTKEY_MODEL_ID=@bedrock-aifoundry-euc1-001/eu.anthropic.claude-sonnet-4-6

# Local dev — set keys directly instead of AGENT_SECRET_NAME. Leave unset to disable.
# PORTKEY_API_KEY=pk-...
# AMPLITUDE_API_KEY=...
# CONFIDENT_API_KEY=confident_us_...
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=dd-api-key=...,dd-otlp-source=llmobs

# Local dev only — NEVER set in a deployed environment. Skips the Portkey
# prompts.render() call that create_agui_app() makes at startup to load the
# platform base prompt, falling back to the SDK's bundled base-prompt file
# instead (see app.py). Importing/constructing the app still works, but the
# base prompt won't reflect whatever the platform team has published in
# Portkey. Does not affect /invocations — an actual chat turn still calls
# the real model via Portkey regardless of this flag.
# OFFLINE_PROMPTS=true

# Local dev / testing only — NOT the platform's sanctioned production path
# (that's the AI Foundry MCP Gateway → Databricks MCP, which carries the
# rep's own identity for row-level security). This is a direct
# databricks-sql-connector connection with no identity propagation — it
# queries as whoever DATABRICKS_TOKEN belongs to, not as the calling rep.
# Set all three to make data_access.py (customer/season/product lists, and
# builder.py's deck numbers) use the real warehouse instead of the local
# dbx-data sample. See databricks_executor.py's docstring.
# DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxx.xx.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# DATABRICKS_TOKEN=dapi...

# Runtime URL in agent card (local dev)
AGENTCORE_RUNTIME_URL=http://127.0.0.1:8081/

# Authorization — comma-separated AD group object-IDs
# Remove the comment below and set your group IDs for RBAC.
# Leave commented out for local dev without auth (don't send an Authorization header).
# ALLOWED_AD_GROUPS=group-object-id-1,group-object-id-2

# Windows local dev — prevents UnicodeEncodeError when LLM emits emoji
PYTHONIOENCODING=utf-8

# ADOT + Datadog telemetry (set via infra for deployed agents)
# AGENT_OBSERVABILITY_ENABLED=true
# In deployment, telemetry tags (service/env/agent + your own) are declared in the
# `otel_tags` tfvars map and the IaC renders them into OTEL_RESOURCE_ATTRIBUTES.
# Set it directly only for local testing:
# OTEL_RESOURCE_ATTRIBUTES=service.name=test_agent,deployment.environment.name=dev
